# Backend only. Copy to .env without replacing an existing configured file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_ENABLED=1
GEMINI_TIMEOUT_MS=12000
SPEECH_ENABLED=1
SPEECH_TIMEOUT_MS=20000
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COOKIE_SECURE=0
# EASY_PAY_DB=/absolute/path/to/demo.sqlite3
# Optional signed IVR gateway. Use at least 32 random characters; never a bank credential.
TELEPHONY_WEBHOOK_SECRET=
